@page "/cart"
@rendermode InteractiveServer
@inject ShopApiClient ShopApi

<PageTitle>Shopping Cart</PageTitle>

<h1>Shopping Cart</h1>

@if (cart == null)
{
    <p><em>Loading...</em></p>
}
else if (!cart.Items.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in cart.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>$@item.UnitPrice</td>
                    <td>@item.Quantity</td>
                    <td>$@(item.UnitPrice * item.Quantity)</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveItem(item.ProductId)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                <td><strong>$@cart.Items.Sum(i => i.UnitPrice * i.Quantity)</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    @if (orderId != null)
    {
        <div class="alert alert-success">
            Successfully checked out! Order ID: @orderId
        </div>
    }
    else
    {
        <div class="mt-4">
            <h3>Checkout</h3>
            <div class="mb-3">
                <label>Name:</label>
                <input class="form-control" @bind="customerName" />
            </div>
            <div class="mb-3">
                <label>Email:</label>
                <input class="form-control" type="email" @bind="customerEmail" />
            </div>
            <button class="btn btn-success" @onclick="Checkout" disabled="@(string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerEmail))">
                Complete Checkout
            </button>
        </div>
    }
}

@code {
    private ShoppingCart? cart;
    private string cartId = "default";
    private string customerName = "";
    private string customerEmail = "";
    private int? orderId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        cart = await ShopApi.GetCartAsync(cartId);
    }

    private async Task RemoveItem(int productId)
    {
        await ShopApi.RemoveFromCartAsync(cartId, productId);
        await LoadCart();
    }

    private async Task Checkout()
    {
        var order = await ShopApi.CheckoutAsync(cartId, customerName, customerEmail);
        if (order != null)
        {
            orderId = order.Id;
            cart = null; // Hide cart
        }
    }
}
