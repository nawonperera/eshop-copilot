@page "/orders/{id:int}"
@rendermode InteractiveServer
@using eshop.Web.Models
@using eshop.Web.Clients
@inject OrderApiClient OrderApi
@inject NavigationManager Navigation

<PageTitle>Order #@Id — eShop</PageTitle>

<section class="page-section">
    @if (isLoading)
    {
        <div class="detail-skeleton">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line skeleton-short"></div>
        </div>
    }
    else if (order is null)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#8c9196" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3>Order not found</h3>
            <p>The order #@Id does not exist or has been removed.</p>
            <a href="/orders" class="btn-primary">← Back to Orders</a>
        </div>
    }
    else
    {
        <header class="detail-header">
            <a href="/orders" class="btn-back">← Back to Orders</a>
            <div class="detail-title-row">
                <h1>Order #@order.Id</h1>
                <span class="status-badge status-@order.Status.ToLower()">@order.Status</span>
            </div>
        </header>

        <div class="detail-grid">
            <div class="detail-card">
                <h3 class="card-section-title">Customer Information</h3>
                <div class="detail-field">
                    <span class="field-label">Name</span>
                    <span class="field-value">@order.CustomerName</span>
                </div>
                <div class="detail-field">
                    <span class="field-label">Email</span>
                    <span class="field-value">@order.CustomerEmail</span>
                </div>
                <div class="detail-field">
                    <span class="field-label">Order Date</span>
                    <span class="field-value">@order.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                </div>
            </div>

            <div class="detail-card">
                <h3 class="card-section-title">Order Summary</h3>
                <div class="detail-field">
                    <span class="field-label">Items</span>
                    <span class="field-value">@order.Items.Count item@(order.Items.Count != 1 ? "s" : "")</span>
                </div>
                <div class="detail-field">
                    <span class="field-label">Total Amount</span>
                    <span class="field-value text-bold text-primary">$@order.TotalAmount.ToString("N2")</span>
                </div>
                <div class="detail-field">
                    <span class="field-label">Status</span>
                    <span class="field-value">@order.Status</span>
                </div>
            </div>
        </div>

        <div class="detail-card mt-lg">
            <h3 class="card-section-title">Order Items</h3>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>$@item.UnitPrice.ToString("N2")</td>
                                <td>@item.Quantity</td>
                                <td class="text-end text-bold">$@((item.UnitPrice * item.Quantity).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="3" class="text-end">Total</td>
                            <td class="text-end text-bold text-primary">$@order.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private Order? order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderApi.GetByIdAsync(Id);
        isLoading = false;
    }
}
